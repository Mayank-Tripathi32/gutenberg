{
	"$schema": "../../schemas/json/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "840px",
			"wideSize": "1100px"
		}
	},
	"customTemplates": [
		{
			"name": "custom-template",
			"title": "Custom",
			"postTypes": [ "post" ]
		}
	],
	"styles": {
		"blocks": {
			"core/paragraph": {
				"elements": {
					"button": {
						"border": {
							"radius": "0px"
						},
						"color": {
							"background": "yellow"
						},
						"spacing": {
							"padding": {
								"top": "20px",
								"right": "20px",
								"bottom": "20px",
								"left": "20px"
							}
						}
					}
				}
			},
			"core/navigation-submenu": {
				"elements": {
					"button": {
						"border": {
							"radius": "0px"
						},
						"color": {
							"background": "yellow"
						},
						"spacing": {
							"padding": {
								"top": "290px",
								"right": "20px",
								"bottom": "20px",
								"left": "20px"
							}
						}
					}
				}
			}
		}
	},
	"patterns": [ "short-text-surrounded-by-round-images", "partner-logos" ]
}
